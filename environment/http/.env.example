# Read by the `docker compose` CLI for ${VARIABLE} substitution inside this
# directory's compose files. NOT injected into any container — that's the
# env/ files' job. Every variable here has a default, so `.env` is optional:
#
#   cp .env.example .env

# Host interface ignis-app is published on. Loopback by default, so the stack
# is reachable from this machine and nowhere else. Set it to 0.0.0.0 only
# where something in front of the host (a firewall, an upstream proxy) decides
# who may connect: this environment terminates no TLS and checks no credential.
HOST_BIND=127.0.0.1

# The host port ignis-app is published on. Not 8080: the EnerPlanET platform's
# Keycloak binds 0.0.0.0:8080, which holds the port on every interface, so a
# loopback HOST_BIND does not avoid it. ignis takes 8088, buem-gateway 8081.
# The two must stay different and must stay off the ports the platform already
# owns. A deployment's orchestration layer assigns this port per service.
HOST_PORT=8088

# The internal port the app listens on, inside its own container. Container
# network-namespace isolation means this never collides across services, so it
# can stay the same everywhere — it is a single source of truth referenced by
# the app and its health check, not a value duplicated in each of those places.
APP_PORT=8080

# Pins ignis-app and ignis-build-db to one published release in
# docker-compose.prod.yml. Unset means `latest`. Published tags carry no `v`
# prefix: release v0.2.4-alpha publishes as 0.2.4-alpha.
# IGNIS_IMAGE_TAG=0.2.4-alpha
