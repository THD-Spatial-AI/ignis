# Read by the `docker compose` CLI for ${VARIABLE} substitution in
# docker-compose.yml, never injected into a container (that is env/'s job).
# Every variable has a default, so `.env` is optional:
#
#   cp .env.example .env

# Set to `https` to start Caddy in front of the API on every `up`.
# COMPOSE_PROFILES=https

# Release that `--no-build` runs. Published tags carry no `v` prefix: release
# v0.8.0 publishes as 0.8.0. Unset means `latest`.
# IGNIS_IMAGE_TAG=0.8.0

# Host interface and port the API is published on. Loopback by default, so it
# is reachable from this machine only. Not 8080: the EnerPlanET platform's
# Keycloak holds 0.0.0.0:8080. ignis takes 8088, buem-gateway 8081.
HOST_BIND=127.0.0.1
HOST_PORT=8088

# Port the API listens on inside its container, read by the API, its health
# check and the Caddy upstream.
APP_PORT=8080

# https profile only. Host port Caddy publishes; ignis keeps 443, buem-gateway
# takes 8443, so both can run on one host.
HOST_HTTPS_PORT=443

# https profile only. The host directory `caddy trust` created, so Caddy reuses
# a CA the OS and browser already trust. Unset, Caddy generates its own CA in a
# Docker volume and clients see a certificate warning.
#   Linux:   ~/.local/share/caddy
#   macOS:   ~/Library/Application Support/Caddy
# CADDY_DATA_DIR=/home/YOUR_USERNAME/.local/share/caddy
