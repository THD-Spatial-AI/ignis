# Database connection settings (connects to the database container on the
# same Docker Compose network, via its service name)
DB_HOST=ignis-db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ignis

# Use "require" in production. Kept on its own line: compose's env_file
# parser strips trailing comments but `docker run --env-file` does not, and a
# mangled sslmode value is a security-relevant failure.
DB_SSL_MODE=disable
